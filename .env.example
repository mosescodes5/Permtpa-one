# PERMTPA ONE — environment template. PLACEHOLDERS ONLY. Copy to .env and set real values locally.
# NEVER commit .env. NEVER put secrets in NEXT_PUBLIC_* variables (they ship to the browser).

APP_ENV=development                 # development | staging | production

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser     # bootstrap superuser, used only by the init script
POSTGRES_DB=permtpa_one
MIGRATOR_DB_PASSWORD=change-me-migrator   # role that owns the schema; used only to run migrations
APP_DB_PASSWORD=change-me-app             # runtime role: not owner, no BYPASSRLS, least privilege

# --- API (server-side only) ---
API_BIND=127.0.0.1:8080
DATABASE_URL=postgres://permtpa_app:change-me-app@127.0.0.1:5432/permtpa_one
MIGRATOR_DATABASE_URL=postgres://permtpa_migrator:change-me-migrator@127.0.0.1:5432/permtpa_one
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379
REDIS_PASSWORD=change-me-redis
RUST_LOG=info,tower_http=info

# --- Authentication & sessions (Milestone 2) — server-side only ---
PUBLIC_URL=http://localhost:3000             # origin of the web app; used in email links
ALLOWED_ORIGINS=http://localhost:3000        # comma-separated; the ONLY origins allowed to make state-changing requests (CSRF)
CSRF_SECRET=change-me-at-least-32-random-chars      # openssl rand -base64 48
MFA_ENCRYPTION_KEY=change-me-base64-of-32-bytes     # openssl rand -base64 32  (encrypts TOTP secrets at rest; rotate with care)
TRUSTED_PROXY_HOPS=0                         # reverse proxies in front of the API. Behind Next's /api proxy use 1.
                                             # NEVER >0 if the API is directly reachable: X-Forwarded-For could be spoofed.
# SMTP for verification/reset emails. Outside development TLS is REQUIRED (smtps:// or ?tls=required).
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="PERMTPA ONE <no-reply@example.com>"

# --- Web (public values only) ---
API_INTERNAL_URL=http://127.0.0.1:8080       # where Next proxies /api/* (server-side; not exposed to the browser)
NEXT_PUBLIC_APP_NAME="PERMTPA ONE"

# --- Added in later milestones (documented here so nothing is surprising) ---
# KORAPAY_SECRET_KEY=            # Milestone 6. Server-side only. Sandbox keys in development.
# KORAPAY_PUBLIC_KEY=
# KORAPAY_WEBHOOK_SECRET=
